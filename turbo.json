{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate-contracts": {
      "outputs": [
        "../packages/contracts/openapi.json",
        "../packages/contracts/src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate-contracts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "generate-contracts"
      ]
    }
  }
}
