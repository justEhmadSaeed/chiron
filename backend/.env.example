APP_ENV=development
API_PORT=8000
# Override default CORS allowlist (comma-separated). Defaults include localhost + chiron-web-eta.vercel.app.
CORS_ORIGINS=http://localhost:3000,https://chiron-web-eta.vercel.app
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Firebase Configuration
# URL of your Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
# For local Docker, mount your service account file and point this at the in-container path.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-credentials.json
# For hosted deployment, prefer a secret env var containing minified JSON instead of a file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Agent/RAG providers
GEMINI_API_KEY=
TAVILY_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=chiron-research
EMBEDDING_MODEL=models/gemini-embedding-2
LLM_MODEL=gemma-4-31b-it
