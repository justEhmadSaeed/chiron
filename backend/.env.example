APP_ENV=development
API_PORT=8000
# Override default CORS allowlist (comma-separated). Defaults include localhost + chiron-web-eta.vercel.app.
CORS_ORIGINS=http://localhost:3000,https://chiron-web-eta.vercel.app
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Firebase Configuration
# URL of your Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
# Path to your downloaded Service Account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Alternatively, you can paste the minified JSON string directly
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
