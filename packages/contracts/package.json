{
  "name": "@chiron/contracts",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate-contracts": "openapi-typescript ./openapi.json -o ./src/generated/api.ts",
    "build": "pnpm run generate-contracts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "test": "echo \"contracts: no tests\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.3.0",
    "typescript": "^5.6.3"
  }
}
